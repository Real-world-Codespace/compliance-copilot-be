# PostgreSQL / RDS stores users, ACL metadata, document registry and audit events.
DATABASE_URL=postgresql+psycopg://app:app_local_only@localhost:5432/procurement
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Private document storage. ECS should obtain credentials from its task role.
S3_REGION=ap-southeast-1
S3_BUCKET=your-private-knowledge-bucket
S3_PRESIGNED_EXPIRY_SECONDS=600
MAX_UPLOAD_SIZE_MB=25

# Required for real production embeddings; never commit a real key.
OPENAI_API_KEY=replace-with-your-secret
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=6

# Production vector store. Create a 1536-dimension cosine Pinecone index first.
# Use the index host shown in the Pinecone console; keep its API key backend-only.
VECTOR_STORE=pinecone
PINECONE_API_KEY=replace-with-your-pinecone-api-key
PINECONE_INDEX_HOST=your-index-host.svc.your-region.pinecone.io
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE_PREFIX=tenant-
