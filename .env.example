# PostgreSQL / RDS stores users, ACL metadata, document registry and audit events.
DATABASE_URL=postgresql+psycopg://app:app_local_only@localhost:5434/procurement
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Private document storage. ECS should obtain credentials from its task role.
S3_REGION=ap-southeast-1
STORAGE_BACKEND=local
S3_BUCKET=
# Optional local credentials; do not set static keys for an ECS task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_PRESIGNED_EXPIRY_SECONDS=600
MAX_UPLOAD_SIZE_MB=25

# Required for real production embeddings; never commit a real key.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=6

# Production vector store. Create a 1536-dimension cosine Pinecone index first.
# Use the index host shown in the Pinecone console; keep its API key backend-only.
VECTOR_STORE=memory
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE_PREFIX=tenant-
